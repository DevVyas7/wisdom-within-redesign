  padding: 11px 10px;
}

.dropdown-panel a:hover {
  background: var(--muted);
}

.header-cta {
  letter-spacing: .04em;
  flex-shrink: 0;
  height: 41px;
  padding-inline: 18px;
  font-size: 11px;
  font-weight: 700;
}

.mobile-menu-button, .mobile-nav {
  display: none;
}

.hero {
  background: var(--dark-surface);
