  .hero-rule {
    margin-bottom: 12px;
  }

  .hero p {
    font-size: 12px;
    line-height: 1.45;
  }

  .hero-actions {
    margin-top: 17px;
  }

  .hero-actions .action-link {
    width: auto;
    height: 39px;
    padding-inline: 11px;
    font-size: 10px;
  }

  .hero-portrait {
    grid-column: 2;
    padding-right: 5px;
  }

  .hero-portrait-frame {
    height: 100%;
    min-height: 275px;
  }

  .hero-portrait-caption {
    padding: 8px;
    font-size: 8px;
  }

  .hero-scroll {
    bottom: 9px;
  }
}

@media (width <= 420px) {
  .hero-portrait-frame {
    height: 100%;
    min-height: 275px;
  }
}

h1, h2, h3, blockquote {
  padding-bottom: .12em;
}

.hero h1, .section-heading h2, .founder-copy h2, .book-copy h2, .highlight-layout h2, .page-header h1, .service-hero h1, .bottom-cta h2 {
  line-height: 1.13;
}

.service-card-title h3, .hero-offering-text strong, .related-links a, .program-row h2, .brand, .footer-brand {
  line-height: 1.18;
}

.programs-section {
  background: var(--background);
  color: var(--foreground);
}

.programs-layout {
  grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
  align-items: start;
  gap: clamp(45px, 8vw, 140px);
  display: grid;
}

.programs-intro {
  padding-top: 14px;
}

.programs-intro .section-heading h2 {
  max-width: 440px;
}

.programs-intro .section-heading p {
  max-width: 360px;
  color: var(--muted-foreground);
}

.programs-intro .text-link {
  color: var(--primary);
  margin-top: 30px;
}

.program-index {
  border-top: 2px solid var(--foreground);
}

.program-index-link {
  border-bottom: 1px solid var(--border);
  grid-template-columns: 48px minmax(0, 1fr) 40px;
  align-items: center;
  column-gap: clamp(14px, 2vw, 30px);
  min-height: 112px;
  padding: 20px 0;
  transition: padding .25s, background-color .25s;
  display: grid;
}

.program-index-link:hover, .program-index-link:focus-visible {
  background: var(--muted);
  padding-left: 16px;
}

.program-index-number {
  font: 700 12px/1.5 var(--font-body);
  color: var(--primary);
  align-self: start;
  padding-top: 6px;
}

.program-index-link h3 {
  max-width: 520px;
  font-size: clamp(27px, 2.5vw, 38px);
  line-height: 1.17;
}

.program-index-arrow {
  border: 1px solid var(--border);
  width: 40px;
  height: 40px;
  color: var(--primary);
  border-radius: 50%;
  place-items: center;
  transition: background-color .25s, color .25s;
  display: grid;
}

.program-index-link:hover .program-index-arrow {
  background: var(--primary);
  color: var(--primary-foreground);
}

.achievements-section {
  background: var(--background);
}

.achievements-layout {
  grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
  gap: clamp(45px, 8vw, 140px);
  display: grid;
}

.achievements-layout h2 {
  margin: 16px 0;
  font-size: clamp(42px, 4.5vw, 68px);
  line-height: 1.13;
}

.achievements-layout > div:first-child > p {
  color: var(--muted-foreground);
}

.achievements-list {
  border-top: 2px solid var(--foreground);
}

.achievement {
  border-bottom: 1px solid var(--border);
  grid-template-columns: 48px 1fr;
  gap: 24px;
  padding: 22px 0;
  display: grid;
}

.achievement-number {
  color: var(--primary);
  font-size: 12px;
  font-weight: 700;
}

.achievement h3 {
  font-size: clamp(24px, 2.3vw, 34px);
  line-height: 1.17;
}

.achievement p {
  color: var(--muted-foreground);
  margin-top: 4px;
  line-height: 1.55;
}

@supports (animation-timeline: view()) {
  @keyframes editorial-reveal {
    from {
      opacity: .78;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}

@media (width <= 700px) {
  .programs-layout, .achievements-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 35px;
  }

  .program-index-link {
    grid-template-columns: 30px minmax(0, 1fr) 36px;
    gap: 10px;
    min-height: 90px;
    padding-block: 16px;
  }

  .program-index-link h3 {
    font-size: clamp(24px, 7vw, 32px);
  }

  .program-index-arrow {
    width: 36px;
    height: 36px;
  }

  .achievement {
    grid-template-columns: 30px 1fr;
    gap: 12px;
  }

  .hero h1, .section-heading h2, .page-header h1, .service-hero h1 {
    overflow-wrap: anywhere;
  }
}

