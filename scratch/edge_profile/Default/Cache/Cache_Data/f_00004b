  color: var(--primary);
  font-size: 11px;
  font-weight: 700;
  line-height: 1.4;
  display: inline-block;
}

.topline {
  background: var(--dark-surface);
  min-height: 31px;
  color: var(--dark-text);
  letter-spacing: .19em;
  justify-content: space-between;
  align-items: center;
  padding: 7px 32px;
  font-size: 9px;
  font-weight: 600;
  display: flex;
}

.site-header {
  z-index: 30;
  background: var(--background);
  border-bottom: 1px solid var(--border);
  position: relative;
}

.header-inner {
  align-items: center;
  gap: 24px;
  min-height: 86px;
  display: flex;
}

.brand, .footer-brand {
  color: var(--foreground);
  font-family: var(--font-display);
  letter-spacing: .09em;
  flex-shrink: 0;
  align-items: center;
  gap: 10px;
  font-size: 16px;
  line-height: .85;
  display: inline-flex;
}

.brand img {
  object-fit: contain;
  border-radius: 50%;
  width: 57px;
  height: 57px;
}

.desktop-nav {
  justify-content: center;
  align-items: center;
  gap: clamp(12px, 1.55vw, 26px);
  margin-left: auto;
  display: flex;
}

.desktop-nav a {
  white-space: nowrap;
  font-size: 12px;
  font-weight: 600;
  transition: color .2s;
}

.desktop-nav a:hover, .desktop-nav a.active {
  color: var(--primary);
}

.nav-dropdown {
  padding-block: 33px;
  position: relative;
}

.nav-dropdown > a {
  align-items: center;
  gap: 3px;
  display: flex;
}

.dropdown-panel {
  background: var(--card);
  border: 1px solid var(--border);
  width: 255px;
  padding: 10px;
  display: none;
  position: absolute;
  top: 100%;
  left: -18px;
  box-shadow: 0 14px 35px oklch(23% .021 54 / .12);
}

.nav-dropdown:hover .dropdown-panel, .nav-dropdown:focus-within .dropdown-panel {
  display: grid;
}

.dropdown-panel a {
