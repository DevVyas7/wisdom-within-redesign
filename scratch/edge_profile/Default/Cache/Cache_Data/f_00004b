  --sidebar-accent-foreground: oklch(98.4% .003 247.858);
  --sidebar-border: oklch(100% 0 0 / .1);
  --sidebar-ring: oklch(55.1% .027 264.364);
}

:root {
  --radius: .25rem;
  --background: oklch(96.007% .01476 80.708);
  --foreground: oklch(30.068% .02955 53.285);
  --card: oklch(96.007% .01476 80.708);
  --card-foreground: var(--foreground);
  --popover: var(--card);
  --popover-foreground: var(--foreground);
  --primary: oklch(58.692% .15218 33.056);
  --primary-foreground: oklch(96.007% .01476 80.708);
  --secondary: oklch(92% .02 80.708);
  --secondary-foreground: var(--foreground);
  --muted: oklch(92.7% .02 80.708);
  --muted-foreground: oklch(47% .027 53.285);
  --accent: oklch(59.526% .04824 137.917);
  --accent-foreground: var(--foreground);
  --border: oklch(76% .025 77);
  --input: var(--border);
  --ring: var(--primary);
  --gold: oklch(65.816% .09534 77.6);
  --sage: oklch(59.526% .04824 137.917);
  --dark-surface: oklch(30.068% .02955 53.285);
  --dark-text: oklch(96.007% .01476 80.708);
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
}

::selection {
  background: var(--accent);
  color: var(--foreground);
}

h1, h2, h3, blockquote {
